---
interface Props { title:string; description:string; lang?:'es'|'en'; canonical?:string; }
const {title,description,lang='es',canonical=Astro.url.pathname}=Astro.props;
const canonicalURL=new URL(canonical,Astro.site);
const otherLang=lang==='es'?'en':'es';
const otherPath=lang==='es'?('/en'+(Astro.url.pathname==='/'?'':Astro.url.pathname)):Astro.url.pathname.replace(/^\/en/,'')||'/';
const jsonLd={'@context':'https://schema.org','@type':'Person',name:'Marcelo Ojeda Cárdenas',url:'https://mojedac.github.io',jobTitle:'Software Architect',sameAs:['https://github.com/mojedac','https://www.linkedin.com/in/mojedac/'],knowsAbout:['Software Architecture','Solution Architecture','Systems Integration','SaaS Architecture','Enterprise Systems','Java','Spring Boot','REST APIs','Google Cloud Platform']};
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <meta name="description" content={description} />
  <meta name="author" content="Marcelo Ojeda Cárdenas" />
  <meta name="theme-color" content="#08111f" />
  <meta name="robots" content="index,follow,max-image-preview:large" />
  <link rel="manifest" href="/site.webmanifest" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="canonical" href={canonicalURL} />
  <link rel="alternate" hreflang={lang} href={canonicalURL} />
  <link rel="alternate" hreflang={otherLang} href={new URL(otherPath,Astro.site)} />
  <meta property="og:type" content="website" /><meta property="og:locale" content={lang === "es" ? "es_CL" : "en_US"} /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:url" content={canonicalURL} /><meta property="og:site_name" content="Marcelo Ojeda — Software Architecture" />
  <meta name="twitter:card" content="summary_large_image" /><title>{title}</title>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</head>
<body>
<a class="skip" href="#content">{lang==='es'?'Ir al contenido':'Skip to content'}</a>
<header class="site-header">
  <a class="brand" href={lang==='es'?'/':'/en/'} aria-label="Marcelo Ojeda, home"><span class="mark">M/O</span><span class="brand-text">Marcelo Ojeda<small>Software Architect</small></span></a>
  <nav aria-label={lang==='es'?'Navegación principal':'Main navigation'}>
    <a href={lang==='es'?'/#work':'/en/#work'}>{lang==='es'?'Casos':'Work'}</a>
    <a href={lang==='es'?'/about/':'/en/about/'}>{lang==='es'?'Perfil':'About'}</a>
    <a class="lang" href={otherPath}>{otherLang.toUpperCase()}</a>
  </nav>
</header>
<main id="content"><slot /></main>
<footer><div><strong>Marcelo Ojeda</strong><span>Software Architect · Santiago, Chile</span></div><div class="footer-links"><a href="https://www.linkedin.com/in/mojedac/" rel="me">LinkedIn</a><a href="https://github.com/mojedac" rel="me">GitHub</a></div></footer>
</body></html>
<style is:global>
:root{--ink:#f3f7fb;--muted:#8b9aab;--line:rgba(255,255,255,.10);--paper:#060b12;--surface:#0b121d;--accent:#73a7ff;--glow:#8b5cf6;--max:1240px}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:radial-gradient(900px 500px at 82% -5%,rgba(115,167,255,.13),transparent 60%),radial-gradient(700px 500px at 10% 35%,rgba(139,92,246,.08),transparent 65%),var(--paper);color:var(--ink);font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;line-height:1.6}a{color:inherit}.skip{position:absolute;left:-9999px}.skip:focus{left:1rem;top:1rem;background:white;color:#111;padding:.6rem;z-index:30}
.site-header,footer{max-width:var(--max);margin:auto;padding:1.35rem 2rem;display:flex;align-items:center;justify-content:space-between}.site-header{position:sticky;top:0;z-index:20;background:rgba(6,11,18,.68);backdrop-filter:blur(24px);border-bottom:1px solid var(--line)}
.brand{display:flex;gap:.8rem;align-items:center;text-decoration:none}.mark{display:grid;place-items:center;width:44px;height:44px;border-radius:13px;background:linear-gradient(135deg,rgba(115,167,255,.18),rgba(139,92,246,.12));border:1px solid rgba(115,167,255,.35);font-weight:800;letter-spacing:-.08em;box-shadow:inset 0 1px rgba(255,255,255,.08)}.brand-text{font-weight:700;line-height:1.05}.brand-text small{display:block;color:var(--muted);font-size:.67rem;font-weight:500;margin-top:.28rem;letter-spacing:.06em;text-transform:uppercase}
nav{display:flex;gap:1.5rem;align-items:center}nav a{text-decoration:none;color:var(--muted);font-size:.88rem}nav a:hover{color:var(--ink)}nav .lang{color:var(--accent);font-weight:800;border-left:1px solid var(--line);padding-left:1.5rem}
section{max-width:var(--max);margin:auto;padding:8rem 2rem}.hero{isolation:isolate}.hero{min-height:82vh;display:grid;align-content:center;position:relative}.hero:after{content:"";position:absolute;right:3%;top:16%;width:min(38vw,480px);aspect-ratio:1;border-radius:50%;background:radial-gradient(circle at 35% 35%,rgba(115,167,255,.34),rgba(139,92,246,.12) 35%,transparent 68%);filter:blur(2px);opacity:.8;z-index:-1;pointer-events:none}.hero:before{content:"";position:absolute;right:10%;top:24%;width:min(24vw,300px);aspect-ratio:1;border:1px solid rgba(115,167,255,.18);border-radius:32% 68% 61% 39%/42% 37% 63% 58%;transform:rotate(18deg);z-index:-1}
.eyebrow{color:var(--accent);text-transform:uppercase;letter-spacing:.16em;font-size:.72rem;font-weight:800}.availability{color:var(--muted);font-size:.92rem;margin:.3rem 0 0}
h1{font-size:clamp(3.5rem,8.5vw,7.7rem);line-height:.91;letter-spacing:-.065em;margin:.65rem 0 1.8rem;max-width:1050px;position:relative;z-index:1}h2{font-size:clamp(2.25rem,4.5vw,4.4rem);line-height:1;letter-spacing:-.05em;margin:0 0 2rem}h3{font-size:1.35rem;line-height:1.2;letter-spacing:-.025em}.lead{font-size:clamp(1.15rem,2vw,1.5rem);max-width:790px;color:var(--muted);position:relative;z-index:1}.kicker{max-width:720px;color:var(--muted);font-size:1.08rem}
.actions{display:flex;gap:.8rem;margin-top:2.2rem;flex-wrap:wrap}.button{display:inline-block;text-decoration:none;padding:.9rem 1.2rem;border:1px solid var(--line);border-radius:999px;font-weight:700;transition:.2s ease}.button.primary{background:var(--ink);border-color:var(--ink);color:#07101d}.button:hover{transform:translateY(-2px);border-color:rgba(115,167,255,.6)}.button:hover{border-color:var(--accent)}
.metrics,.cards,.split{display:grid}.metrics{grid-template-columns:repeat(3,1fr);margin-top:5rem;border-top:1px solid var(--line);padding-top:1.5rem}.metric{padding:1.25rem 2rem 1.25rem 0}.card,.panel{padding:2rem;border:1px solid var(--line);border-radius:22px;background:linear-gradient(145deg,rgba(255,255,255,.045),rgba(255,255,255,.012));box-shadow:0 18px 60px rgba(0,0,0,.14)}.metric+.metric{border-left:1px solid var(--line);padding-left:2rem}.card+.card,.panel+.panel{margin-left:1rem}.metric strong{display:block;font-size:2rem;letter-spacing:-.04em;color:var(--ink)}.metric span,.card p,.panel p{color:var(--muted)}.cards,.split{grid-template-columns:repeat(2,1fr);gap:1rem}.card{text-decoration:none;transition:transform .25s,border-color .25s}.card:hover{transform:translateY(-6px);border-color:rgba(115,167,255,.45)}.card .num{font-size:.72rem;color:var(--accent);font-weight:800;letter-spacing:.1em}.card .arrow{font-size:1.5rem;color:var(--accent)}
.tags{display:flex;gap:.5rem;flex-wrap:wrap;margin-top:1.5rem}.tag{border:1px solid var(--line);padding:.4rem .7rem;font-size:.78rem;color:var(--muted)}.process{display:grid;grid-template-columns:repeat(4,1fr);gap:1rem}.process>div{padding:1.5rem;border-top:1px solid rgba(115,167,255,.35)}.process>div:last-child{border-right:0}.process b{color:var(--accent);font-size:.75rem}.process p{color:var(--muted)}
footer{border-top:1px solid var(--line);margin-top:6rem;color:var(--muted);font-size:.82rem}footer div{display:flex;gap:1rem}footer strong{color:var(--ink)}.footer-links a{text-decoration:none}
@media(max-width:760px){.brand-text{display:none}.site-header,footer{padding:1rem 1.25rem}nav{gap:1rem}.metrics,.cards,.split,.process{grid-template-columns:1fr}.metric+.metric,.card+.card,.panel+.panel{border-left:0;border-top:1px solid var(--line)}.process>div{border-right:0;border-bottom:1px solid var(--line)}section{padding:5rem 1.25rem}.hero{min-height:76vh}.hero:after{display:none}h1{font-size:clamp(3.1rem,15vw,5.2rem)}footer{align-items:flex-start;flex-direction:column;gap:1rem}}
</style>