---
interface Props {title:string;description:string;lang?:'es'|'en';canonical?:string}
const {title,description,lang='es',canonical=Astro.url.pathname}=Astro.props;
const canonicalURL=new URL(canonical,Astro.site); const otherLang=lang==='es'?'en':'es';
const otherPath=lang==='es'?('/en'+(Astro.url.pathname==='/'?'':Astro.url.pathname)):Astro.url.pathname.replace(/^\/en/,'')||'/';
const jsonLd={'@context':'https://schema.org','@type':'Person',name:'Marcelo Ojeda Cárdenas',url:'https://mojedac.github.io',jobTitle:'Software Architect',sameAs:['https://github.com/mojedac','https://www.linkedin.com/in/mojedac/'],knowsAbout:['Software Architecture','Solution Architecture','Systems Integration','SaaS Architecture','Enterprise Systems','Java','Spring Boot','REST APIs','Google Cloud Platform']};
---
<!doctype html><html lang={lang}><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content={description}/><meta name="author" content="Marcelo Ojeda Cárdenas"/><meta name="theme-color" content="#f1efe9"/><meta name="robots" content="index,follow,max-image-preview:large"/><link rel="manifest" href="/site.webmanifest"/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/><link rel="canonical" href={canonicalURL}/><link rel="alternate" hreflang={lang} href={canonicalURL}/><link rel="alternate" hreflang={otherLang} href={new URL(otherPath,Astro.site)}/><meta property="og:type" content="website"/><meta property="og:locale" content={lang==='es'?'es_CL':'en_US'}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonicalURL}/><meta property="og:site_name" content="Marcelo Ojeda — Software Architecture"/><meta name="twitter:card" content="summary_large_image"/><title>{title}</title><script type="application/ld+json" set:html={JSON.stringify(jsonLd)}/></head>
<body><a class="skip" href="#content">{lang==='es'?'Ir al contenido':'Skip to content'}</a><header class="nav"><a class="identity" href={lang==='es'?'/':'/en/'}><b>Marcelo Ojeda</b><span>Software Architect</span></a><nav><a href={lang==='es'?'/#work':'/en/#work'}>{lang==='es'?'Trabajo':'Work'}</a><a href={lang==='es'?'/about/':'/en/about/'}>{lang==='es'?'Perfil':'About'}</a><a class="language" href={otherPath}>{otherLang.toUpperCase()}</a></nav></header><main id="content"><slot/></main><footer><p>Marcelo Ojeda <span>— Software Architect, Santiago</span></p><div><a href="https://www.linkedin.com/in/mojedac/" rel="me">LinkedIn ↗</a><a href="https://github.com/mojedac" rel="me">GitHub ↗</a></div></footer></body></html>
<style is:global>
:root{--paper:#f1efe9;--ink:#111315;--muted:#64676b;--line:#c9c6bd;--accent:#1747ff;--max:1320px}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--paper);color:var(--ink);font-family:Arial,Helvetica,sans-serif;line-height:1.45}a{color:inherit}.skip{position:absolute;left:-9999px}.skip:focus{left:1rem;top:1rem;z-index:50}.nav{height:86px;max-width:var(--max);margin:auto;padding:0 2.25rem;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid var(--line)}.identity{text-decoration:none;display:flex;align-items:baseline;gap:.8rem}.identity b{font-size:.95rem}.identity span{font-size:.72rem;color:var(--muted)}.nav nav{display:flex;gap:1.6rem;align-items:center}.nav nav a{font-size:.78rem;text-decoration:none}.nav .language{border:1px solid var(--ink);border-radius:100%;width:40px;height:40px;display:grid;place-items:center;font-size:.65rem}
main{overflow:hidden}.hero{max-width:var(--max);min-height:calc(100vh - 86px);margin:auto;padding:7vw 2.25rem 4rem;position:relative}.hero .index{font:700 .7rem/1 monospace;color:var(--accent);letter-spacing:.1em}.hero h1{font-size:clamp(4.2rem,10.5vw,9.7rem);line-height:.82;letter-spacing:-.075em;margin:1.4rem 0 3rem;max-width:1180px;font-weight:700}.hero h1 em{font-style:normal;color:var(--accent)}.hero-copy{display:grid;grid-template-columns:1fr minmax(300px,560px);gap:4rem;align-items:end}.hero-copy p{grid-column:2;margin:0;font-size:clamp(1.1rem,1.6vw,1.45rem);color:var(--muted)}.hero-meta{position:absolute;right:2.25rem;top:2rem;font:600 .64rem/1.4 monospace;color:var(--muted);text-align:right;text-transform:uppercase;letter-spacing:.08em}
.band{border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.band-inner{max-width:var(--max);margin:auto;padding:1.15rem 2.25rem;display:flex;justify-content:space-between;gap:2rem;font:600 .68rem/1.3 monospace;text-transform:uppercase;letter-spacing:.07em}.band-inner span:last-child{color:var(--accent)}
.chapter{max-width:var(--max);margin:auto;padding:9rem 2.25rem}.chapter-head{display:grid;grid-template-columns:1fr 3fr;gap:2rem;margin-bottom:5rem}.chapter-head .label{font:700 .68rem/1 monospace;color:var(--accent);text-transform:uppercase;letter-spacing:.1em}.chapter-head h2{font-size:clamp(3rem,6vw,6.5rem);line-height:.9;letter-spacing:-.06em;margin:0;max-width:950px}.chapter-head p{grid-column:2;color:var(--muted);font-size:1.15rem;max-width:660px}
.story-list{border-top:1px solid var(--ink)}.story{display:grid;grid-template-columns:80px 1.2fr 1fr 60px;gap:2rem;align-items:start;padding:2.6rem 0;border-bottom:1px solid var(--line);text-decoration:none;transition:padding .25s}.story:hover{padding-left:1rem}.story .n{font:700 .7rem/1 monospace;color:var(--accent)}.story h3{font-size:clamp(1.8rem,3vw,3.2rem);line-height:1;letter-spacing:-.045em;margin:0}.story p{margin:0;color:var(--muted);max-width:460px}.story .arrow{font-size:2rem;text-align:right}
.statement{max-width:var(--max);margin:auto;padding:12rem 2.25rem}.statement p{font-size:clamp(2.8rem,6vw,6.3rem);line-height:.95;letter-spacing:-.055em;margin:0;max-width:1150px}.statement p span{color:var(--muted)}
.timeline{border-top:1px solid var(--ink)}.timeline-row{display:grid;grid-template-columns:150px 1fr 1fr;gap:2rem;padding:1.6rem 0;border-bottom:1px solid var(--line)}.timeline-row time{font:600 .7rem/1.4 monospace;color:var(--accent)}.timeline-row strong{font-size:1.05rem}.timeline-row p{margin:0;color:var(--muted)}
.pill-link{display:inline-block;margin-top:2rem;border-bottom:1px solid var(--ink);padding:.4rem 0;text-decoration:none;font-weight:700}.techline{display:flex;gap:.8rem 1.8rem;flex-wrap:wrap;border-top:1px solid var(--line);padding-top:1.2rem;margin-top:3rem;font:600 .7rem/1.3 monospace;text-transform:uppercase;color:var(--muted)}
.case-intro{max-width:var(--max);margin:auto;padding:8rem 2.25rem 6rem}.case-intro .case-no{font:700 .68rem/1 monospace;color:var(--accent)}.case-intro h1{font-size:clamp(3.7rem,8vw,8.2rem);line-height:.86;letter-spacing:-.07em;margin:1.5rem 0 3rem;max-width:1100px}.case-intro .lede{font-size:1.3rem;color:var(--muted);max-width:720px;margin-left:auto}.case-facts{max-width:var(--max);margin:auto;padding:2rem 2.25rem;display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid var(--ink);border-bottom:1px solid var(--ink)}.case-facts div{padding-right:2rem}.case-facts small{display:block;font:700 .62rem/1 monospace;color:var(--accent);text-transform:uppercase;margin-bottom:.6rem}.case-facts strong{font-size:1.1rem}.case-body{max-width:var(--max);margin:auto;padding:8rem 2.25rem}.case-body .prose{display:grid;grid-template-columns:1fr 2fr;gap:3rem;margin-bottom:8rem}.case-body .prose h2{font-size:clamp(2.4rem,4.5vw,5rem);line-height:.95;letter-spacing:-.05em;margin:0}.case-body .prose div{max-width:680px}.case-body .prose p{font-size:1.1rem;color:var(--muted)}
.system-flow{margin:6rem 0;display:grid;grid-template-columns:repeat(7,auto);align-items:center;gap:1rem}.system-flow .node{font:700 .72rem/1.2 monospace;text-transform:uppercase;padding:.9rem 0;border-top:2px solid var(--ink);min-width:110px}.system-flow .node.accent{border-color:var(--accent);color:var(--accent)}.system-flow .link{color:var(--muted);text-align:center}.decision-list{border-top:1px solid var(--ink)}.decision{display:grid;grid-template-columns:90px 1fr 2fr;gap:2rem;padding:1.8rem 0;border-bottom:1px solid var(--line)}.decision b{font:700 .68rem/1 monospace;color:var(--accent)}.decision strong{font-size:1.15rem}.decision p{margin:0;color:var(--muted)}
footer{max-width:var(--max);margin:8rem auto 0;padding:2rem 2.25rem 3rem;border-top:1px solid var(--ink);display:flex;justify-content:space-between;font-size:.75rem}footer p{margin:0}footer p span{color:var(--muted)}footer div{display:flex;gap:1.5rem}footer a{text-decoration:none}
@media(max-width:760px){.nav{height:72px;padding:0 1.2rem}.identity span{display:none}.nav nav{gap:.9rem}.hero{min-height:auto;padding:5rem 1.2rem 3rem}.hero h1{font-size:clamp(3.7rem,19vw,6rem)}.hero-copy{grid-template-columns:1fr}.hero-copy p{grid-column:1}.hero-meta{display:none}.band-inner,.chapter,.statement,.case-intro,.case-body{padding-left:1.2rem;padding-right:1.2rem}.chapter{padding-top:6rem;padding-bottom:6rem}.chapter-head{grid-template-columns:1fr;margin-bottom:3rem}.chapter-head p{grid-column:1}.story{grid-template-columns:45px 1fr 35px;gap:1rem}.story p{grid-column:2}.timeline-row{grid-template-columns:90px 1fr}.timeline-row p{grid-column:2}.case-facts{grid-template-columns:1fr;padding:0 1.2rem}.case-facts div{padding:1.2rem 0;border-bottom:1px solid var(--line)}.case-body .prose{grid-template-columns:1fr;margin-bottom:5rem}.system-flow{grid-template-columns:1fr;gap:.3rem}.system-flow .link{text-align:left;transform:rotate(90deg);width:20px}.decision{grid-template-columns:45px 1fr}.decision p{grid-column:2}footer{margin-top:5rem;padding:1.5rem 1.2rem;flex-direction:column;gap:1rem}}
</style>